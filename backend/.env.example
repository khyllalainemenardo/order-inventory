# Copy to .env (which is gitignored) and fill in from the Supabase dashboard:
# Dashboard -> Connect -> Session pooler -> JDBC tab.
#
# Use the SESSION pooler on port 5432, not the transaction pooler on 6543.
# Hibernate uses server-side prepared statements, which transaction mode does not support.

SUPABASE_DB_URL=jdbc:postgresql://POOLER-HOST:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=your-database-password
